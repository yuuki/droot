# A service run by droot in a private mount namespace (--unshare): its mounts
# disappear when it stops, so no `droot umount` is needed.
# See documentation/deployment.md.
[Unit]
Description=app (droot container)
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
# Messages of droot itself as JSON objects in the journal.
Environment=DROOT_LOG_FORMAT=json
# Passed to the application by env = ["APP_ENV"] in app.toml (a bare KEY
# takes its value from droot's environment).
Environment=APP_ENV=production
# The options of droot run are in examples/droot/app.toml, installed as
# /etc/droot/app.toml.
ExecStart=/usr/local/bin/droot run --config /etc/droot/app.toml
# droot replaces itself with the command: systemd signals the application
# directly. Use the STOPSIGNAL of the image, if any.
KillSignal=SIGTERM
Restart=on-failure
RestartSec=5s

# Resource limits: droot creates no cgroups, systemd does.
MemoryMax=1G
CPUQuota=200%
TasksMax=512
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
